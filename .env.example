# Optional. Compose works without any .env file; copy this to .env only to override.
# This file holds PLACEHOLDERS ONLY. Real values go in the untracked .env, and
# scripts/check-env-example.mjs fails any commit or CI run that puts a secret here.

# Host port the gateway listens on (the only published port).
GATEWAY_PORT=8080

# ---- Supabase and mail (ADR 0013, ADR 0014) -------------------------------------------------
# Not needed: compose has DEV-ONLY defaults for all of these, and nothing is reachable from outside
# the compose networks. `make env` writes random per-machine values into the untracked .env instead
# (run `make down` first if the stack was already started: the database keeps its first password).
# POSTGRES_PASSWORD=
# JWT_SECRET=
# SECRET_KEY_BASE=
# REALTIME_DB_ENC_KEY=
# DASHBOARD_PASSWORD=
# Apply supabase/seed.sql on start (development only; the seed must be idempotent).
SEED_DEV_DATA=true
# Public base URL used in links the app puts in emails (never taken from request headers).
PUBLIC_BASE_URL=http://localhost:8080

# ---- Object storage (feature 08, ADR 0004) --------------------------------------------
# fs  = local volume, needs nothing else (default; the reviewer path).
# s3  = Cloudflare R2 or any S3-compatible store, configured below.
OBJECT_STORE_DRIVER=fs

# Account endpoint WITHOUT the bucket name, for example https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=<https://account-id.r2.cloudflarestorage.com>
# R2's S3 API uses "auto" (verify during the storage spike).
STORAGE_REGION=auto
STORAGE_BUCKET=deal-pipeline-tracker
# Object key prefix inside the bucket: Dev/ for development, Prod/ for production.
# The app refuses to start if it does not match the environment.
STORAGE_KEY_PREFIX=Dev/
STORAGE_FORCE_PATH_STYLE=true
# Dedicated token for THIS project: Object Read & Write, scoped to the bucket above.
STORAGE_ACCESS_KEY_ID=<set in .env>
STORAGE_SECRET_ACCESS_KEY=<set in .env>
