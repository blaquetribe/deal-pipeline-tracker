junit.xml

# Logs and runtime files
logs/
*.log
npm-debug.log*
pnpm-debug.log*
*.pid

# Supabase local state (migrations, seed and tests ARE committed)
supabase/.temp/
supabase/.branches/
supabase/volumes/
supabase/.env

# Docker and compose local state
docker-compose.override.yml
compose.override.yml
.docker-cache/
volumes/
